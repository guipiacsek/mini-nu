{:paths ["src" "resources"]
 :deps {org.clojure/clojure {:mvn/version "1.12.6"}
        com.datomic/local {:mvn/version "1.0.301"}
        metosin/reitit {:mvn/version "0.11.0"}
        ring/ring-jetty-adapter {:mvn/version "1.15.6"}
        prismatic/schema {:mvn/version "1.4.2"}
        com.stuartsierra/component {:mvn/version "1.2.0"}}
 :aliases
 {:run {:main-opts ["-m" "mini-nu.system"]}
  :build {:deps {io.github.clojure/tools.build {:git/tag "v0.10.14" :git/sha "1176afd"}}
          :ns-default build}
  :test {:extra-paths ["test"]
         :extra-deps {nubank/matcher-combinators {:mvn/version "3.11.0"}
                      org.clojure/test.check {:mvn/version "1.1.3"}
                      io.github.cognitect-labs/test-runner {:git/tag "v0.5.1" :git/sha "dfb30dd"}}
         :main-opts ["-m" "cognitect.test-runner"]}}}
